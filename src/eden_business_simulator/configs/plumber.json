{
  "schema_version": 1,
  "business_type": "plumber",
  "version": "1.0",
  "events": [
    {
      "event_type": "service_ticket_created",
      "base_weight": 8,
      "guard": "has_customers",
      "in_catalog": true
    },
    {
      "event_type": "estimate_requested",
      "base_weight": 4,
      "guard": "has_open_tickets",
      "in_catalog": true
    },
    {
      "event_type": "estimate_approved",
      "base_weight": 3,
      "guard": "has_open_tickets",
      "in_catalog": true
    },
    {
      "event_type": "technician_assigned",
      "base_weight": 6,
      "guard": "has_open_tickets",
      "in_catalog": true
    },
    {
      "event_type": "technician_dispatched",
      "base_weight": 5,
      "guard": "has_assigned",
      "in_catalog": true
    },
    {
      "event_type": "technician_arrived",
      "base_weight": 5,
      "guard": "has_dispatched",
      "in_catalog": true
    },
    {
      "event_type": "diagnosis_recorded",
      "base_weight": 5,
      "guard": "has_arrived",
      "in_catalog": true
    },
    {
      "event_type": "parts_used",
      "base_weight": 4,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "work_completed",
      "base_weight": 5,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "customer_sign_off",
      "base_weight": 4,
      "guard": "has_work_completed",
      "in_catalog": true
    },
    {
      "event_type": "invoice_generated",
      "base_weight": 4,
      "guard": "has_work_completed",
      "in_catalog": true
    },
    {
      "event_type": "payment_received",
      "base_weight": 3,
      "guard": "has_invoiced",
      "in_catalog": true
    },
    {
      "event_type": "follow_up_scheduled",
      "base_weight": 2,
      "guard": "has_work_completed",
      "in_catalog": true
    },
    {
      "event_type": "vehicle_location_update",
      "base_weight": 3,
      "guard": "has_dispatched",
      "in_catalog": true
    },
    {
      "event_type": "parts_reorder_placed",
      "base_weight": 2,
      "guard": "has_diagnosed",
      "in_catalog": true
    }
  ],
  "dayparts": [],
  "domain": {
    "categories": [
      "leak_repair",
      "drain_cleaning",
      "pipe_install",
      "emergency"
    ],
    "parts": [
      [
        "prt_p001",
        "pvc_pipe_10ft",
        8.0
      ],
      [
        "prt_p002",
        "faucet_cartridge",
        22.0
      ],
      [
        "prt_p003",
        "p_trap_kit",
        12.5
      ],
      [
        "prt_p004",
        "water_heater_element",
        35.0
      ]
    ]
  },
  "initial_state": {
    "defaults": {
      "initial_techs": 3,
      "initial_vehicles": 2,
      "initial_customers": 5
    },
    "types": {
      "initial_techs": "int",
      "initial_vehicles": "int",
      "initial_customers": "int"
    }
  },
  "kpis": [
    {
      "name": "revenue",
      "kind": "sum",
      "event_type": "payment_received",
      "field": "amount"
    },
    {
      "name": "jobs_completed",
      "kind": "count",
      "event_type": "work_completed"
    },
    {
      "name": "invoices",
      "kind": "count",
      "event_type": "invoice_generated"
    },
    {
      "name": "avg_job_value",
      "kind": "ratio",
      "numerator": "revenue",
      "denominator": "jobs_completed"
    },
    {
      "name": "parts_cost",
      "kind": "sum",
      "event_type": "parts_used",
      "field": "unit_cost"
    }
  ],
  "actions": [
    {
      "action_type": "assign_technician",
      "effect": "assign_technician",
      "effect_event_type": "technician_assigned",
      "params": [
        {"name": "ticket_id", "type": "string", "required": true},
        {"name": "technician_id", "type": "string", "required": true},
        {"name": "eta_minutes", "type": "integer", "min": 5, "max": 240}
      ]
    },
    {
      "action_type": "dispatch_technician",
      "effect": "dispatch_technician",
      "effect_event_type": "technician_dispatched",
      "params": [
        {"name": "ticket_id", "type": "string", "required": true}
      ]
    },
    {
      "action_type": "order_parts",
      "effect": "order_parts",
      "effect_event_type": "parts_reorder_placed",
      "params": [
        {"name": "part_id", "type": "string", "required": true},
        {"name": "qty", "type": "integer", "required": true, "min": 1, "max": 100}
      ]
    },
    {
      "action_type": "approve_estimate",
      "effect": "approve_estimate",
      "effect_event_type": "estimate_approved",
      "params": [
        {"name": "ticket_id", "type": "string", "required": true},
        {"name": "labor_estimate", "type": "number", "required": true, "min": 10, "max": 10000},
        {"name": "parts_estimate", "type": "number", "required": true, "min": 0, "max": 10000}
      ]
    },
    {
      "action_type": "chase_invoice",
      "effect": "chase_invoice",
      "effect_event_type": "invoice_chased",
      "params": [
        {"name": "invoice_id", "type": "string", "required": true},
        {"name": "channel", "type": "string", "enum": ["email", "phone", "sms"]}
      ]
    },
    {
      "action_type": "schedule_follow_up",
      "effect": "schedule_follow_up",
      "effect_event_type": "follow_up_scheduled",
      "params": [
        {"name": "ticket_id", "type": "string", "required": true},
        {"name": "days_ahead", "type": "integer", "min": 1, "max": 180},
        {"name": "follow_up_type", "type": "string", "enum": ["maintenance_check", "warranty_check", "satisfaction_call"]}
      ]
    }
  ]
}
