{
  "schema_version": 1,
  "business_type": "ecommerce",
  "version": "1.0",
  "events": [
    {
      "event_type": "customer_created",
      "base_weight": 5,
      "guard": null,
      "in_catalog": true
    },
    {
      "event_type": "product_viewed",
      "base_weight": 30,
      "guard": "has_customers_and_products",
      "in_catalog": true
    },
    {
      "event_type": "cart_updated",
      "base_weight": 20,
      "guard": "has_customers_and_products",
      "in_catalog": true
    },
    {
      "event_type": "checkout_started",
      "base_weight": 8,
      "guard": "has_cart_items",
      "in_catalog": true
    },
    {
      "event_type": "payment_info_entered",
      "base_weight": 6,
      "guard": "has_cart_items",
      "in_catalog": true
    },
    {
      "event_type": "order_placed",
      "base_weight": 10,
      "guard": "has_cart_items",
      "in_catalog": true
    },
    {
      "event_type": "payment_processed",
      "base_weight": 15,
      "guard": "has_placed_orders",
      "in_catalog": true
    },
    {
      "event_type": "order_shipped",
      "base_weight": 5,
      "guard": "has_paid_orders",
      "in_catalog": true
    },
    {
      "event_type": "inventory_adjusted",
      "base_weight": 5,
      "guard": "has_products",
      "in_catalog": true
    },
    {
      "event_type": "refund_issued",
      "base_weight": 2,
      "guard": "has_shipped_orders",
      "in_catalog": true
    }
  ],
  "dayparts": [],
  "domain": {
    "currencies": [
      "USD",
      "EUR",
      "GBP",
      "AUD",
      "CAD"
    ]
  },
  "initial_state": {
    "defaults": {
      "initial_customers": 5,
      "initial_products": 20
    },
    "types": {
      "initial_customers": "int",
      "initial_products": "int"
    }
  },
  "kpis": [
    {
      "name": "revenue",
      "kind": "sum_where",
      "event_type": "payment_processed",
      "field": "amount",
      "filter_field": "status",
      "filter_value": "approved"
    },
    {
      "name": "orders",
      "kind": "count",
      "event_type": "order_placed"
    },
    {
      "name": "refunds",
      "kind": "sum",
      "event_type": "refund_issued",
      "field": "amount"
    },
    {
      "name": "refund_count",
      "kind": "count",
      "event_type": "refund_issued"
    },
    {
      "name": "views",
      "kind": "count",
      "event_type": "product_viewed"
    }
  ],
  "actions": [
    {
      "action_type": "adjust_price",
      "effect": "adjust_price",
      "effect_event_type": "product_price_adjusted",
      "requires_approval": true,
      "params": [
        {"name": "product_id", "type": "string", "required": true},
        {"name": "new_price", "type": "number", "required": true, "min": 0.5, "max": 10000}
      ]
    },
    {
      "action_type": "restock_product",
      "effect": "restock_product",
      "effect_event_type": "inventory_adjusted",
      "params": [
        {"name": "product_id", "type": "string", "required": true},
        {"name": "qty", "type": "integer", "required": true, "min": 1, "max": 10000}
      ]
    },
    {
      "action_type": "issue_refund",
      "effect": "issue_refund",
      "effect_event_type": "refund_issued",
      "requires_approval": true,
      "params": [
        {"name": "order_id", "type": "string", "required": true},
        {"name": "reason", "type": "string", "enum": ["defective", "not_as_described", "changed_mind", "manager_goodwill"]}
      ]
    },
    {
      "action_type": "expedite_order",
      "effect": "expedite_order",
      "effect_event_type": "order_expedited",
      "params": [
        {"name": "order_id", "type": "string", "required": true},
        {"name": "carrier", "type": "string", "enum": ["FedEx", "UPS", "DHL", "USPS"]}
      ]
    }
  ]
}
