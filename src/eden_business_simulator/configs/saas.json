{
  "schema_version": 1,
  "business_type": "saas",
  "version": "1.0",
  "events": [
    {
      "event_type": "account_signed_up",
      "base_weight": 1.0,
      "guard": null,
      "in_catalog": true
    },
    {
      "event_type": "plan_subscribed",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "feature_used",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "invoice_generated",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "payment_succeeded",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "payment_failed",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "support_ticket_opened",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "ticket_resolved",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    },
    {
      "event_type": "churned",
      "base_weight": 1.0,
      "guard": "has_accounts",
      "in_catalog": true
    }
  ],
  "dayparts": [],
  "domain": {
    "plans": [
      [
        "starter",
        29.0,
        "month"
      ],
      [
        "growth",
        79.0,
        "month"
      ],
      [
        "enterprise",
        249.0,
        "month"
      ]
    ],
    "features": [
      "api_call",
      "report_export",
      "user_invited",
      "workflow_run",
      "storage_gb",
      "support_chat"
    ],
    "severities": [
      "low",
      "medium",
      "high",
      "critical"
    ],
    "churn_reasons": [
      "too_expensive",
      "missing_features",
      "switched_competitor",
      "project_ended",
      "not_using"
    ]
  },
  "initial_state": {
    "defaults": {
      "initial_accounts": 3
    },
    "types": {
      "initial_accounts": "int"
    }
  },
  "kpis": [
    {
      "name": "new_accounts",
      "kind": "count",
      "event_type": "account_signed_up"
    },
    {
      "name": "churned",
      "kind": "count",
      "event_type": "churned"
    },
    {
      "name": "invoices_paid",
      "kind": "count",
      "event_type": "payment_succeeded"
    },
    {
      "name": "invoices_failed",
      "kind": "count",
      "event_type": "payment_failed"
    },
    {
      "name": "revenue",
      "kind": "sum",
      "event_type": "payment_succeeded",
      "field": "amount"
    },
    {
      "name": "mrr_end",
      "kind": "snapshot",
      "field": "position.mrr"
    },
    {
      "name": "tickets_opened",
      "kind": "count",
      "event_type": "support_ticket_opened"
    }
  ],
  "actions": [
    {
      "action_type": "chase_invoice",
      "effect": "chase_invoice",
      "effect_event_type": "invoice_chased",
      "params": [
        {"name": "invoice_id", "type": "string", "required": true},
        {"name": "channel", "type": "string", "enum": ["email", "phone", "portal"]}
      ]
    },
    {
      "action_type": "change_plan_price",
      "effect": "change_plan_price",
      "effect_event_type": "plan_price_changed",
      "requires_approval": true,
      "params": [
        {"name": "plan_name", "type": "string", "required": true, "enum": ["starter", "growth", "enterprise"]},
        {"name": "new_monthly_fee", "type": "number", "required": true, "min": 1, "max": 10000}
      ]
    },
    {
      "action_type": "freeze_account",
      "effect": "freeze_account",
      "effect_event_type": "account_frozen",
      "params": [
        {"name": "account_id", "type": "string", "required": true},
        {"name": "reason", "type": "string", "enum": ["payment_failure", "fraud_review", "customer_request", "manager_action"]}
      ]
    },
    {
      "action_type": "unfreeze_account",
      "effect": "unfreeze_account",
      "effect_event_type": "account_unfrozen",
      "params": [
        {"name": "account_id", "type": "string", "required": true}
      ]
    },
    {
      "action_type": "offer_discount",
      "effect": "offer_discount",
      "effect_event_type": "discount_offered",
      "requires_approval": true,
      "params": [
        {"name": "account_id", "type": "string", "required": true},
        {"name": "percent", "type": "integer", "required": true, "min": 1, "max": 90},
        {"name": "months", "type": "integer", "min": 1, "max": 24}
      ]
    },
    {
      "action_type": "resolve_ticket",
      "effect": "resolve_ticket",
      "effect_event_type": "ticket_resolved",
      "params": [
        {"name": "ticket_id", "type": "string", "required": true},
        {"name": "resolution", "type": "string", "enum": ["fixed", "answered", "escalated", "refunded"]}
      ]
    }
  ]
}
