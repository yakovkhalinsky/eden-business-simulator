{
  "schema_version": 1,
  "business_type": "clinic",
  "version": "1.0",
  "events": [
    {
      "event_type": "appointment_scheduled",
      "base_weight": 8,
      "guard": "has_patients",
      "in_catalog": true
    },
    {
      "event_type": "appointment_cancelled",
      "base_weight": 2,
      "guard": "has_scheduled",
      "in_catalog": true
    },
    {
      "event_type": "appointment_rescheduled",
      "base_weight": 2,
      "guard": "has_scheduled",
      "in_catalog": true
    },
    {
      "event_type": "patient_checked_in",
      "base_weight": 6,
      "guard": "has_scheduled",
      "in_catalog": true
    },
    {
      "event_type": "vitals_recorded",
      "base_weight": 5,
      "guard": "has_checked_in",
      "in_catalog": true
    },
    {
      "event_type": "encounter_started",
      "base_weight": 6,
      "guard": "has_checked_in",
      "in_catalog": true
    },
    {
      "event_type": "diagnosis_recorded",
      "base_weight": 5,
      "guard": "has_active_encounters",
      "in_catalog": true
    },
    {
      "event_type": "procedure_performed",
      "base_weight": 5,
      "guard": "has_active_encounters",
      "in_catalog": true
    },
    {
      "event_type": "lab_order_placed",
      "base_weight": 4,
      "guard": "has_active_encounters",
      "in_catalog": true
    },
    {
      "event_type": "lab_result_received",
      "base_weight": 3,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "medication_prescribed",
      "base_weight": 3,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "claim_submitted",
      "base_weight": 3,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "claim_adjudicated",
      "base_weight": 2,
      "guard": "has_claims",
      "in_catalog": true
    },
    {
      "event_type": "payment_posted",
      "base_weight": 2,
      "guard": "has_claims",
      "in_catalog": true
    },
    {
      "event_type": "referral_sent",
      "base_weight": 2,
      "guard": "has_diagnosed",
      "in_catalog": true
    },
    {
      "event_type": "no_show_recorded",
      "base_weight": 2,
      "guard": "has_scheduled",
      "in_catalog": true
    }
  ],
  "dayparts": [],
  "domain": {
    "appointment_types": [
      "new_patient_visit",
      "annual_physical",
      "follow_up",
      "sick_visit"
    ],
    "icd10": [
      [
        "Z00.00",
        "routine_health_exam"
      ],
      [
        "E11.9",
        "type_2_diabetes"
      ],
      [
        "I10",
        "essential_hypertension"
      ],
      [
        "J06.9",
        "acute_upper_respiratory_infection"
      ]
    ],
    "cpt": [
      [
        "99213",
        "office_visit_established"
      ],
      [
        "99214",
        "office_visit_established_extended"
      ],
      [
        "99395",
        "annual_physical"
      ]
    ]
  },
  "initial_state": {
    "defaults": {
      "initial_providers": 3,
      "initial_patients": 6
    },
    "types": {
      "initial_providers": "int",
      "initial_patients": "int"
    }
  },
  "kpis": [
    {
      "name": "revenue",
      "kind": "sum",
      "event_type": "payment_posted",
      "field": "amount"
    },
    {
      "name": "appointments",
      "kind": "count",
      "event_type": "appointment_scheduled"
    },
    {
      "name": "no_shows",
      "kind": "count",
      "event_type": "no_show_recorded"
    },
    {
      "name": "no_show_rate",
      "kind": "ratio",
      "numerator": "no_shows",
      "denominator": "appointments"
    },
    {
      "name": "cancellations",
      "kind": "count",
      "event_type": "appointment_cancelled"
    },
    {
      "name": "claims_submitted",
      "kind": "count",
      "event_type": "claim_submitted"
    },
    {
      "name": "claims_denied",
      "kind": "count_where",
      "event_type": "claim_adjudicated",
      "filter_field": "status",
      "filter_value": "denied"
    }
  ],
  "actions": [
    {
      "action_type": "schedule_appointment",
      "effect": "schedule_appointment",
      "effect_event_type": "appointment_scheduled",
      "params": [
        {
          "name": "patient_id",
          "type": "string",
          "required": true
        },
        {
          "name": "provider_id",
          "type": "string",
          "required": true
        },
        {
          "name": "appointment_type",
          "type": "string",
          "required": true,
          "enum": [
            "new_patient_visit",
            "annual_physical",
            "follow_up",
            "sick_visit"
          ]
        },
        {
          "name": "starts_in_hours",
          "type": "number",
          "required": true,
          "min": 0.25,
          "max": 720
        }
      ]
    },
    {
      "action_type": "cancel_appointment",
      "effect": "cancel_appointment",
      "effect_event_type": "appointment_cancelled",
      "params": [
        {
          "name": "appointment_id",
          "type": "string",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "enum": [
            "patient_request",
            "provider_unavailable",
            "no_longer_needed"
          ]
        }
      ]
    },
    {
      "action_type": "reschedule_appointment",
      "effect": "reschedule_appointment",
      "effect_event_type": "appointment_rescheduled",
      "params": [
        {
          "name": "appointment_id",
          "type": "string",
          "required": true
        },
        {
          "name": "starts_in_hours",
          "type": "number",
          "required": true,
          "min": 0.25,
          "max": 720
        },
        {
          "name": "reason",
          "type": "string",
          "enum": [
            "patient_request",
            "provider_unavailable"
          ]
        }
      ]
    },
    {
      "action_type": "add_provider_shift",
      "effect": "add_provider_shift",
      "effect_event_type": "provider_shift_added",
      "params": [
        {
          "name": "provider_id",
          "type": "string",
          "required": true
        },
        {
          "name": "shift_hours",
          "type": "number",
          "min": 1,
          "max": 16
        }
      ]
    },
    {
      "action_type": "chase_claim",
      "effect": "chase_claim",
      "effect_event_type": "claim_chased",
      "params": [
        {
          "name": "claim_id",
          "type": "string",
          "required": true
        },
        {
          "name": "channel",
          "type": "string",
          "enum": [
            "email",
            "phone",
            "portal"
          ]
        }
      ]
    }
  ]
}
